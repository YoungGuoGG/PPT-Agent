{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PPT Agent V2",
  "version": "0.1.0",
  "identifier": "com.officeagent.pptagent.v2",
  "build": {
    "beforeDevCommand": "npm --prefix ../ppt-agent-ui run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../ppt-agent-ui run build",
    "frontendDist": "../../ppt-agent-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PPT Agent",
        "width": 1440,
        "height": 760,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": "#F5F5F7CC"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../deploy/windows/dist/ppt-agent-v2-sidecar.zip": "ppt-agent-v2-sidecar.zip"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
